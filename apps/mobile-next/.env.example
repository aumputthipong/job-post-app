# Copy to .env.local (gitignored) only to run against the real Firebase project.
# Without it the app uses the local emulators, which is the normal way to develop.
# Values are the web config in apps/mobile/database/firebaseDB.js.
EXPO_PUBLIC_USE_PRODUCTION_FIREBASE=1
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: defaults to http://<your machine>:4000. The API must also run in
# production mode (npm run dev -w @jobapp-platform/api), not api:emulators.
# EXPO_PUBLIC_API_URL=
