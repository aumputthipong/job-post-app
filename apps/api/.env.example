# Copy this file to .env and fill in real values. .env is gitignored.

PORT=4000

# Path to the Firebase service account JSON key, relative to apps/api/.
# Get it from: Firebase Console > Project Settings > Service Accounts >
# Generate new private key. This file must NEVER be committed — it grants
# full admin access to the SAME Firestore/Auth/Storage project the mobile
# app already uses.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloudinary — media storage, replaces Firebase Storage (which is unusable on
# this project: the bucket has no billing account, so it returns 402 to clients
# and "billing account absent" to the Admin SDK).
# Free account, no credit card: https://cloudinary.com/users/register_free
# Values come from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
