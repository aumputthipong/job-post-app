rules_version = '2';

// Phase 3: clients read, only the server writes.
//
// Every write in the app now goes through the API, which uses the Firebase
// Admin SDK — that bypasses these rules entirely, so denying writes here costs
// the backend nothing. What it buys is that the app's API key, which ships
// inside every copy of the app and is public by design, no longer grants
// anyone the ability to change data.
//
// Reads stay on the client on purpose: Firestore's realtime listeners are the
// reason the app feels live, and routing reads through the API would throw
// that away for no benefit.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Posts and everything hanging off them: any signed-in user may read,
    // nobody may write. Writes arrive through the API instead.
    match /JobPosts/{postId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /HirePosts/{postId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /FavoriteJobs/{favId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /JobComments/{commentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /HireComments/{commentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /JobRatings/{ratingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /HireRatings/{ratingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // "User Info" and "User Noti" contain a space, which cannot be written as
    // a literal path segment in the rules grammar — matched via a wildcard and
    // narrowed by name instead. This block only ever grants access to those
    // two collections; everything else falls through to deny-by-default.
    match /{collection}/{docId} {
      // Profiles are readable by any signed-in user because the app shows
      // other people's profiles on their posts.
      allow read: if signedIn() && collection == 'User Info';

      // Notification preferences are private to their owner. A query without
      // a matching notiBy filter is refused, which is intended: listing this
      // collection would hand one user everyone else's settings.
      allow read: if signedIn() && collection == 'User Noti'
                  && resource.data.notiBy == uid();

      allow write: if false;
    }
  }
}
