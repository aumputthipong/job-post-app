rules_version = '2';

// Nothing in the app touches Firebase Storage any more — uploads go to
// Cloudinary through POST /uploads — and the bucket is unreachable regardless,
// since the project has no billing account attached (clients get 402, the
// Admin SDK gets "billing account is disabled in state absent").
//
// So this denies everything. It replaces rules that allowed unauthenticated
// read AND write on every object in the bucket, which would have been a real
// hole the moment billing was ever enabled.
//
// If billing is turned on later to recover the 53 objects still in there,
// apps/api/scripts/backup-storage.ts reads them through the Admin SDK, which
// bypasses these rules — no need to loosen anything to get the files out.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
